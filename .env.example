APP_ENV=development
POSTGRES_USER=kpi
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=kpi_command_center
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Opcional: reemplaza los campos POSTGRES_* (postgresql+psycopg2://...)
# DATABASE_URL=
# Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=45
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
LOW_CASH_THRESHOLD=20
STALE_AFTER_MINUTES=15
SEED_ADMIN_EMAIL=admin@bank.com
SEED_ADMIN_PASSWORD=admin123
PGADMIN_DEFAULT_EMAIL=admin@bank.com
PGADMIN_DEFAULT_PASSWORD=change-this-pgadmin-password
GOOGLE_MAPS_API_KEY=
